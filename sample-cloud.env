# =============================================================================
# Mini AI Interviewer — CLOUD environment template (100% OpenRouter, no Ollama)
#
#   1. Copy this file:   cp sample-cloud.env .env
#   2. Fill in OPENROUTER_API_KEY and NEO4J_PASSWORD.
#
# Leaves `COMPOSE_PROFILES` empty so the `ollama` container is NOT built or started.
# Uses OpenRouter exclusively for both the Interviewer Agent and Analysis Pipeline.
# =============================================================================

# Leave empty in cloud mode so Docker Compose skips the `ollama` container
COMPOSE_PROFILES=


# --- Interviewer Agent LLM via OpenRouter (used by: agent) --------------------
LLM_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free

# --- Analysis Pipeline LLMs via OpenRouter (used by: analysis) ----------------
ANALYSIS_LLM_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
LLM_MODEL_SUMMARY=openrouter/nvidia/nemotron-3.5-super-vl:free
LLM_MODEL_INSIGHTS=openrouter/nvidia/nemotron-3.5-super-vl:free

# Required for all OpenRouter models (`openrouter/...`).
OPENROUTER_API_KEY=


# --- Interview behavior (used by: agent, mcp) ---------------------------------
# Configurable min/max number of main questions per interview.
INTERVIEW_MIN_QUESTIONS=2
INTERVIEW_MAX_QUESTIONS=4
# Optional fixed override (e.g. 3). Leave empty to use INTERVIEW_MIN_QUESTIONS..INTERVIEW_MAX_QUESTIONS.
INTERVIEW_NUM_QUESTIONS=


# --- MCP tools server (used by: agent, mcp) -----------------------------------
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_PORT=8001
# Optional shared secret between agent and mcp. Empty = no auth.
MCP_AUTH_TOKEN=


# --- Neo4j (used by: analysis, neo4j) -----------------------------------------
# Leave NEO4J_URI empty to disable the graph (JSON storage still works).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Minimum 8 characters.
NEO4J_PASSWORD=change-me-please


# --- NeoDash UI (used by: neodash) --------------------------------------------
# false = Editor Mode (create/edit Table, Bar, Graph cards); true = read-only Standalone Mode.
NEODASH_PORT=5005
NEODASH_STANDALONE=false
NEODASH_PROTOCOL=bolt
NEODASH_HOST=localhost
NEODASH_NEO4J_PORT=7687
NEODASH_DATABASE=neo4j


# --- NLP models (used by: analysis; baked into the image at build time) -------
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
KEYWORD_MODEL=sentence-transformers/all-MiniLM-L6-v2


# --- Storage (used by: agent, mcp, analysis) ----------------------------------
DATA_DIR=./data


# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
