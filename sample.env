# =============================================================================
# Mini AI Interviewer — environment template
#
#   1. Copy this file:   cp sample.env .env
#   2. Fill in the values (at least NEO4J_PASSWORD).
#
# The values below are for running the services LOCALLY (outside Docker).
# docker-compose.yml automatically overrides the hostnames for containers
# (localhost -> mcp / neo4j / host.docker.internal), so the same .env works for both.
# =============================================================================


# --- LLM via LiteLLM (used by: agent) ----------------------------------------
# Local  (Ollama):      ollama_chat/qwen3:8b   (or ollama_chat/qwen3:1.7b for quick smoke tests)
# Cloud  (OpenRouter):  openrouter/qwen/qwen-2.5-72b-instruct
#                       openrouter/meta-llama/llama-3.3-70b-instruct
LLM_MODEL=ollama_chat/qwen3:8b

# Optional: a different (stronger) model only for the final summary. Empty = LLM_MODEL.
LLM_MODEL_SUMMARY=

# Ollama endpoint when the agent runs locally.
OLLAMA_API_BASE=http://localhost:11434

# Ollama endpoint when the agent runs in Docker:
#   Ollama installed on your machine     -> http://host.docker.internal:11434
#   Ollama container (profile local-llm) -> http://ollama:11434
OLLAMA_API_BASE_DOCKER=http://host.docker.internal:11434

# Required only when LLM_MODEL starts with openrouter/...
OPENROUTER_API_KEY=


# --- Interview behavior (used by: agent) -------------------------------------
# Optional fixed number of questions per interview (e.g. 2 for quick testing, or 4).
# Leave empty to auto-pick from the rubric (clamped between 3 and 5).
INTERVIEW_NUM_QUESTIONS=


# --- MCP tools server (used by: agent, mcp) -----------------------------------
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_PORT=8001
# Optional shared secret between agent and mcp. Empty = no auth.
MCP_AUTH_TOKEN=


# --- Neo4j (used by: mcp, neo4j) ----------------------------------------------
# Leave NEO4J_URI empty to disable the graph (JSON storage still works).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Minimum 8 characters.
NEO4J_PASSWORD=change-me-please


# --- NLP models (used by: mcp; baked into the image at build time) ------------
# For Romanian / multilingual interviews use:
#   SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
#   KEYWORD_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
KEYWORD_MODEL=sentence-transformers/all-MiniLM-L6-v2


# --- Storage (used by: mcp) ---------------------------------------------------
# Folder for interviews_output.json (relative to the repo root when running locally).
DATA_DIR=./data


# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
