# =============================================================================
# Mini AI Interviewer — environment template
#
#   1. Copy this file:   cp sample.env .env
#   2. Fill in the values (at least NEO4J_PASSWORD).
#
# The values below are for running the services LOCALLY (outside Docker).
# docker-compose.yml automatically overrides the hostnames for containers
# (localhost -> mcp / neo4j / host.docker.internal), so the same .env works for both.
# =============================================================================


# --- Interviewer Agent LLM via LiteLLM (used by: agent) ---------------------
# Local  (Ollama):      ollama_chat/mimo-v2.6:9b  (or ollama_chat/qwen3:1.7b)
# Cloud  (OpenRouter):  openrouter/nvidia/nemotron-3.5-super-vl:free
LLM_MODEL=ollama_chat/mimo-v2.6:9b

# --- Analysis Pipeline LLMs via Ollama (used by: analysis) -------------------
# Kept separate from `LLM_MODEL` so the analyzer always uses local Ollama models.
ANALYSIS_LLM_MODEL=ollama_chat/mimo-v2.6:9b
LLM_MODEL_SUMMARY=ollama_chat/mimo-v2.6:9b
LLM_MODEL_INSIGHTS=ollama_chat/qwen3:1.7b

# Ollama endpoint when running locally.
OLLAMA_API_BASE=http://localhost:11434

# Ollama endpoint when running in Docker:
OLLAMA_API_BASE_DOCKER=http://host.docker.internal:11434

# Required only when LLM_MODEL starts with openrouter/...
OPENROUTER_API_KEY=


# --- Interview behavior (used by: agent) -------------------------------------
# Optional fixed number of questions per interview (e.g. 3).
# Leave empty to clamp automatically between 3 and 5.
INTERVIEW_NUM_QUESTIONS=


# --- MCP tools server (used by: agent, mcp) -----------------------------------
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_PORT=8001
# Optional shared secret between agent and mcp. Empty = no auth.
MCP_AUTH_TOKEN=


# --- Neo4j (used by: analysis, neo4j) -----------------------------------------
# Leave NEO4J_URI empty to disable the graph (JSON storage still works).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Minimum 8 characters.
NEO4J_PASSWORD=change-me-please


# --- NeoDash UI (used by: neodash) --------------------------------------------
# false = Editor Mode (create/edit Table, Bar, Graph cards); true = read-only Standalone Mode.
NEODASH_PORT=5005
NEODASH_STANDALONE=false
NEODASH_PROTOCOL=bolt
NEODASH_HOST=localhost
NEODASH_NEO4J_PORT=7687
NEODASH_DATABASE=neo4j


# --- NLP models (used by: analysis; baked into the image at build time) -------
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
KEYWORD_MODEL=sentence-transformers/all-MiniLM-L6-v2


# --- Storage (used by: agent, mcp, analysis) ----------------------------------
DATA_DIR=./data


# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
